@font-face {
	font-family: 'DrukCyrMedium';
	src: url('../../../../Fonts/DrukCyr-Medium.eot');
	src: url('../../../../Fonts/DrukCyr-Medium.eot?#iefix') format('embedded-opentype'), url('../../../../Fonts/DrukCyr-Medium.woff') format('woff'), url('../../../../Fonts/DrukCyr-Medium.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'Mazzard M';
	src: url('../../../../Fonts/Mazzard/MazzardM-SemiBold.eot');
	src: url('../../../../Fonts/Mazzard/MazzardM-SemiBold.eot?#iefix') format('embedded-opentype'), url('../../../../Fonts/Mazzard/MazzardM-SemiBold.woff') format('woff'),
		url('../../../../Fonts/Mazzard/MazzardM-SemiBold.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'DrukCyr Bold';
	src: url('../../../../Fonts/DrukCyr-Bold.ttf') format('truetype');
}

@font-face {
	font-family: 'DrukTextWide';
	src: url('../../../../Fonts/DRUKTEXTWIDECYR-BOLD.otf') format('truetype');
}

@font-face {
	font-family: 'Montserrat SemiBold';
	src: url('../../../../Fonts/Montserrat/MONTSERRAT-SEMIBOLD.ttf') format('truetype');
}

@font-face {
	font-family: 'Montserrat Bold';
	src: url('../../../../Fonts/Montserrat/MONTSERRAT-BOLD.TTF') format('truetype');
}

:local(.wrapperTopResult) {
	--titleRowDark: #850533;
	--rowDark: #94103e;
	--rowLight: #b00745;

	--red: #ff181899;
	--green: #00db0099;
	--yellow: #ff961599;

	--redDark: #ff1818;
	--greenDark: #00db00;
	--yellowDark: #ff9615;

	--gold: #efc60c95;
	--white: #fff;
	--black: #000;
}

.wrapperTopResult {
	font-family: 'DrukCyrMedium', sans-serif;
	display: block;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	width: 100%;
	z-index: 20;
	position: relative;
	color: var(--white);
}

.wrapperTopResult img {
	height: auto;
	width: 100%;
}

.wrapperTourInfo {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-family: 'Montserrat Bold', sans-serif;
	height: 3vw;
	color: var(--white);
	font-size: 1.4vw;
}

.nameTour {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	padding: 0vw 1vw 0 1vw;
	background: var(--titleRowDark);
	border-radius: 1vw;
}

.topResult {
	display: block;
	height: 100%;
	width: 100%;
	top: 4vw;
	position: absolute;
}

.wrapperPlayerTitle {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 3vw;
}

.playerTitle {
	display: grid;
	align-content: center;
	justify-content: space-between;
	grid-template-columns: 6% 9% 15% 9% 9% 9% 10% 9% 9% 9%;
	height: 100%;
	width: 100%;
	border-top-left-radius: 1vw;
	border-top-right-radius: 1vw;
	background: var(--titleRowDark);
}

.playerTitle div {
	display: flex;
	width: 100%;
	color: var(--goldDark);
	justify-content: center;
	align-items: center;
	font-family: 'Montserrat Bold', sans-serif;
	font-size: 1.1vw;
}

.wrapperPlayer {
	display: block;
	width: 100%;
	border-bottom-left-radius: 1vw;
	border-bottom-right-radius: 1vw;
	font-family: 'DrukTextWide', sans-serif;
	position: relative;
}

.wrapperDiffPosition {
	background: var(--rowDark);
	position: relative;
}

.player {
	font-family: 'DrukTextWide', sans-serif;
	display: grid;
	align-content: center;
	justify-content: space-between;
	height: 100%;
	width: 100%;
	grid-template-columns: 6% 9% 15% 9% 9% 9% 10% 9% 9% 9%;
}

.player div {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 3.9vw;
	text-shadow: 1px 1px 1px var(--titleRowDark);
	font-size: clamp(0.6rem, 1vw, 2rem);
}

.wrapperPlayer .wrapperDiffPosition:nth-child(even) {
	background: var(--rowLight);
}

.wrapperDiffPosition:last-child {
	border-bottom-left-radius: 1vw;
	border-bottom-right-radius: 1vw;
}

.player .logoTeam {
	display: flex;
	justify-content: center;
	align-items: center;
}

.player .logoTeam img {
	height: 3rem;
	width: auto;
}

.diffPositionPlayer {
	display: flex;
	justify-content: center;
	align-items: center;
	min-width: 3vw;
	right: -1.6vw;
	padding: 0.3vw 0.3vw;
	top: -0.2vw;
	font-size: 0.8vw;
	border-radius: 1vw;
	text-shadow: 1px 1px 1px var(--titleRowDark);
	position: absolute;
}
