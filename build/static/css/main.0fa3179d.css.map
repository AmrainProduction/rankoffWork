@font-face {
	font-family: 'DrukCyr Medium';
	src: url('../../../Fonts/DrukCyr-Medium.eot');
	src: url('../../../Fonts/DrukCyr-Medium.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/DrukCyr-Medium.woff') format('woff'), url('../../../Fonts/DrukCyr-Medium.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'Mazzard M';
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot');
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.woff') format('woff'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'DrukCyr Bold';
	src: url('../../../Fonts/DrukCyr-Bold.ttf') format('truetype');
}

@font-face {
	font-family: 'DrukTextWide';
	src: url('../../../Fonts/DRUKTEXTWIDECYR-BOLD.otf') format('truetype');
}

@font-face {
	font-family: 'Montserrat SemiBold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-SEMIBOLD.ttf') format('truetype');
}

@font-face {
	font-family: 'Montserrat Bold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-BOLD.TTF') format('truetype');
}

@font-face {
	font-family: 'Montserrat ExtraBold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-EXTRABOLD.TTF') format('truetype');
}

:local(.wrapperTopResult) {
	/* --titleRowDark: #97103f;
	--rowDark: #c3094b;
	--rowLight: #ec0358; */

	--titleRowDark: #850533;
	--rowDark: #94103e;
	--rowLight: #b00745;

	--red: #ff181899;
	--green: #00db0099;
	--yellow: #ff961599;

	--redDark: #ff1818;
	--greenDark: #00db00;
	--yellowDark: #ff9615;

	--gold: #efc60c95;
	--white: #fff;
	--black: #000;
}

.bgImg {
	height: auto;
	width: 100%;
}

.wrapperMenu {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	width: 100%;
	height: 15%;
	background: var(--mainLightBlack);
	margin-bottom: 10px;
	padding: 5px;
}

.wrapperLogo {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: 10%;
	height: 100%;
}

.wrapperLogo img {
	height: auto;
	width: 100%;
}

.menu {
	display: flex;
	justify-content: center;
	align-items: flex-end;
	height: 100%;
	width: 60%;
}

.wrapperListMatches {
	display: block;
	width: 100%;
	height: 100%;
	margin-right: 2%;
	margin-left: 2%;
	padding: 2px;
}

.titleBox {
	width: 100%;
	height: auto;
	padding: 1% 0;
	color: var(--textColor);
}

.listMatches {
	display: block;
	overflow-y: scroll;
	border-radius: 3px;
	width: 100%;
	min-width: 150px;
	height: 120px;
	background: var(--componentBlockColor);
	color: var(--textColor);
}

.match {
	background: var(--componentLightBlockColor);
	margin-bottom: 2px;
	padding: 5px;
	cursor: pointer;
	transition: all 0.5s;
}

.match:hover {
	background: var(--componentBlockColorHover);
}

.btnSaveAsImage {
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 3px;
	padding: 1%;
	background: var(--buttonColor);
	height: 120px;
	width: 100%;
	cursor: pointer;
	color: var(--textColor);
}

.btnSaveAsImage:hover {
	background: var(--buttonColorHover);
}

.wrapperTopResult {
	display: block;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	width: 100%;
	z-index: 20;
	position: relative;
}

.wrapperTopResult img {
	height: auto;
	width: 100%;
}

.wrapperTourInfo {
	display: grid;
	justify-items: start;
	align-items: center;
	top: 3.9vw;
	height: 11.3vw;
	width: 100%;
	padding: 0 3vw;
	grid-template-rows: calc(70% - 1.3vw) 30%;
	grid-template-columns: 80% 20%;
	row-gap: 1.3vw;
	grid-template-areas:
		'logoRankoff logoTour'
		'nameTour logoTour';
	position: absolute;
}

.nameTourWrapper {
	grid-area: nameTour;
	display: flex;
	justify-content: center;
	align-items: center;
	font-family: 'Montserrat Bold', sans-serif;
	height: 100%;
	color: var(--white);
	font-size: 1.7vw;
}

.nameTour {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	padding: 0vw 1vw;
	background: var(--titleRowDark);
	border-radius: 1vw;
}

.logoRankoff {
	grid-area: logoRankoff;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: 100%;
	height: 100%;
}

.logoRankoff img {
	width: auto;
	height: 100%;
}

.titleBanner {
	font-family: 'DrukCyr Medium', sans-serif;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	font-size: 7.85vw;
	padding-bottom: 0.071vw;
	margin-left: 1.2vw;
	color: var(--white);
}

.logoTour {
	grid-area: logoTour;
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 100%;
}

.logoTour img {
	width: auto;
	height: 100%;
}

.topResult {
	font-family: 'Montserrat ExtraBold', sans-serif;
	top: 16.4vw;
	height: 100%;
	width: 100%;
	color: var(--white);
	padding: 0 3vw;
	position: absolute;
}

.wrapperPlayerTitle {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 3.4vw;
}

.playerTitle {
	font-family: 'Montserrat Bold', sans-serif;
	display: grid;
	grid-template-columns: 5% 8% 20% repeat(12, 1fr);
	height: 100%;
	width: 100%;
	border-top-left-radius: 1vw;
	border-top-right-radius: 1vw;
	overflow: hidden;
	background: var(--titleRowDark);
}

.playerTitle div {
	font-size: 1.1vw;
	display: flex;
	justify-content: center;
	align-items: center;
}

.playerTitle div:not(:last-child) {
	margin-right: 0.4vw;
}

.wrapperPlayer {
	display: block;
	border-bottom-left-radius: 1vw;
	border-bottom-right-radius: 1vw;
	font-family: 'DrukTextWide', sans-serif;
	font-size: 1.05vw;
	overflow: hidden;
}

.wrapperPlayer div:not(:last-child) {
	margin-right: 0.4vw;
}

.wrapperPlayer .player:nth-child(even) {
	background: var(--rowLight);
}

.player {
	display: grid;
	grid-template-columns: 5% 8% 20% repeat(12, 1fr);
	height: 3.85vw;
	width: 100%;
	background: var(--rowDark);
}

.player div {
	text-shadow: 1px 1px 1px var(--titleRowDark);
}

.dataNicknamePlayerNickname {
	display: grid;
	grid-template-columns: 30% calc(70% - 0.4vw);
	grid-template-rows: 100%;
	grid-template-areas: 'logoPlayer nickname';
	height: 100%;
	width: 100%;
	overflow: hidden;
	color: var(--white);
	position: relative;
}

.nickname {
	grid-area: nickname;
	display: flex;
	justify-content: flex-start;
	padding-left: 0.5vw;
	align-items: center;
	width: 100%;
	height: 100%;
}

.logoPlayer {
	grid-area: logoPlayer;
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 100%;
	overflow: hidden;
	position: absolute;
}

.logoPlayer img {
	width: auto;
	height: 220%;
	position: absolute;
	top: 0.1vw;
}

.contnentCenter {
	display: flex;
	justify-content: center;
	align-items: center;
}

.logoTeam {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
}

.logoTeam img {
	height: auto;
	width: 45%;
}
