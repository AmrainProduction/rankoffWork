@font-face {
	font-family: 'DrukCyrMedium';
	src: url('../../../Fonts/DrukCyr-Medium.eot');
	src: url('../../../Fonts/DrukCyr-Medium.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/DrukCyr-Medium.woff') format('woff'), url('../../../Fonts/DrukCyr-Medium.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'Mazzard M';
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot');
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.woff') format('woff'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

.wrapperTopResult {
	--titleRowDark: #850533;
	--rowDark: #94103e;
	--rowLight: #b00745;

	--red: #ff181899;
	--green: #00db0099;
	--yellow: #ff961599;

	--redDark: #ff1818;
	--greenDark: #00db00;
	--yellowDark: #ff9615;

	--gold: #efc60c95;
	--white: #fff;
	--black: #000;
}

.wrapperPicture {
	display: flex;
	width: 100%;
	min-height: 1000px;
	height: 100%;
	position: relative;
}

.wrapperPicture img {
	height: auto;
	width: 100%;
}

.rankoffAndNameEvent {
	top: 3.9vw;
	height: 6.55vw;
	width: 100%;

	padding: 0 3vw 0 3vw;
	position: absolute;
}

.nameTour {
	font-family: 'Mazzard M', sans-serif;
	width: 100%;
	height: 20%;
	color: white;
	font-size: 1.7vw;
}

.logoRankoff {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: 100%;
	height: 100%;
}

.logoRankoff img {
	width: auto;
	height: 100%;
}

.titleBanner {
	font-family: 'DrukCyrMedium', sans-serif;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	font-size: 7.85vw;
	padding-bottom: 0.071vw;
	margin-left: 1.2vw;
	color: white;
}

.wrapperTops {
	margin: 0 auto;
	display: grid;
	width: 100%;
	grid-template-columns: 1fr 1fr;
	column-gap: 1vw;
	padding: 12vw 1vw 1vw 1vw;
	min-height: 100%;
	position: absolute;
}

.leftTop {
	height: 100%;
	width: 100%;
	padding-left: 1vw;
	border-radius: 1vw;
}

.rightTop {
	height: 100%;
	width: 100%;
	padding-right: 1vw;
	border-radius: 1vw;
}

.bgImg {
	height: 2000px;
	width: 100%;
}

.bgImg {
	height: auto;
	width: 100%;
}

.wrapperMenu {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	width: 100%;
	height: 15%;
	background: var(--mainLightBlack);
	margin-bottom: 10px;
	padding: 5px;
}

.wrapperLogo {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: 10%;
	height: 100%;
}

.wrapperLogo img {
	height: auto;
	width: 100%;
}

.menu {
	display: flex;
	justify-content: center;
	align-items: flex-end;
	height: 100%;
	width: 60%;
}

.wrapperListMatches {
	display: block;
	width: 100%;
	height: 100%;
	margin-right: 2%;
	margin-left: 2%;
	padding: 2px;
}

.titleBox {
	width: 100%;
	height: auto;
	padding: 1% 0;
	color: white;
}

.listMatches {
	display: block;
	overflow-y: scroll;
	border-radius: 3px;
	width: 100%;
	min-width: 150px;
	height: 120px;
	background: var(--componentBlockColor);
	color: white;
}

.match {
	background: var(--componentLightBlockColor);
	margin-bottom: 2px;
	padding: 5px;
	cursor: pointer;
	transition: all 0.5s;
}

.match:hover {
	background: var(--componentBlockColorHover);
}

.btnSaveAsImage {
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 3px;
	padding: 1%;
	background: var(--buttonColor);
	height: 120px;
	width: 100%;
	cursor: pointer;
	color: white;
}

.btnSaveAsImage:hover {
	background: var(--buttonColorHover);
}

.wrapperTopResult {
	font-family: 'DrukCyrMedium', sans-serif;
	display: block;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	width: 100%;
	z-index: 20;
	position: relative;
}

.wrapperTopResult img {
	height: auto;
	width: 100%;
}

.wrapperTourInfo {
	display: flex;
	align-items: flex-end;
	width: 100%;
	position: absolute;
}

.nameTour {
	font-family: 'Mazzard M', sans-serif;
	width: 100%;
	height: 20%;
	color: white;
	font-size: clamp(9px, 1.5vw, 36px);
}

.logoTour {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 15%;
	height: 100%;
}

.logoTour img {
	width: auto;
	height: 70%;
}
