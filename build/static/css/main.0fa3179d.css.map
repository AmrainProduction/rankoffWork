@font-face {
	font-family: 'DrukCyr Medium';
	src: url('../../../../Fonts/DrukCyr-Medium.eot');
	src: url('../../../../Fonts/DrukCyr-Medium.eot?#iefix') format('embedded-opentype'), url('../../../../Fonts/DrukCyr-Medium.woff') format('woff'), url('../../../../Fonts/DrukCyr-Medium.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'Mazzard M';
	src: url('../../../../Fonts/Mazzard/MazzardM-SemiBold.eot');
	src: url('../../../../Fonts/Mazzard/MazzardM-SemiBold.eot?#iefix') format('embedded-opentype'), url('../../../../Fonts/Mazzard/MazzardM-SemiBold.woff') format('woff'),
		url('../../../../Fonts/Mazzard/MazzardM-SemiBold.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'DrukCyr Bold';
	src: url('../../../../Fonts/DrukCyr-Bold.ttf') format('truetype');
}

@font-face {
	font-family: 'DrukTextWide';
	src: url('../../../../Fonts/DRUKTEXTWIDECYR-BOLD.otf') format('truetype');
}

@font-face {
	font-family: 'Montserrat SemiBold';
	src: url('../../../../Fonts/Montserrat/MONTSERRAT-SEMIBOLD.ttf') format('truetype');
}

@font-face {
	font-family: 'Montserrat Bold';
	src: url('../../../../Fonts/Montserrat/MONTSERRAT-BOLD.TTF') format('truetype');
}

@font-face {
	font-family: 'Montserrat ExtraBold';
	src: url('../../../../Fonts/Montserrat/MONTSERRAT-EXTRABOLD.TTF') format('truetype');
}

:local(.wrapperTopResult) {
	--titleRowDark: #850533;
	--rowDark: #94103e;
	--rowLight: #b00745;

	--red: #ff181899;
	--green: #00db0099;
	--yellow: #ff961599;

	--redDark: #ff1818;
	--greenDark: #00db00;
	--yellowDark: #ff9615;

	--gold: #efc60c95;
	--white: #fff;
	--black: #000;
}

.wrapperTopResult {
	font-family: 'DRUKTEXTWIDECYR-BOLD', sans-serif;
	display: block;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	width: 100%;
	z-index: 20;
	color: white;
	position: relative;
}

.wrapperTopResult img {
	height: auto;
	width: 100%;
}

.wrapperInfoMatches {
	display: grid;
	justify-content: space-between;
	align-content: center;
	width: 100%;
	height: 5.5vw;
	top: 3vw;
	padding: 0 3vw;
	grid-template-rows: 100%;
	grid-template-columns: auto auto;
	position: absolute;
}

.logoRankoff {
	display: flex;
	align-items: center;
	width: auto;
	height: 100%;
}

.logoRankoff img {
	height: 100%;
	width: auto;
}

.wrapperTitleBanner {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: flex-end;
	align-items: center;
	width: 100%;
	font-size: 2vw;
	height: 100%;
}

.titleBanner {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	width: auto;
	padding: 0 1vw;
	font-size: 2vw;
	height: 4vw;
	color: black;
	border-radius: 0.8vw;
	background: var(--white);
}

.dateMatches {
	display: flex;
	justify-content: center;
	align-items: center;
	width: auto;
	height: 100%;
	margin-right: 1.5vw;
	font-size: 2vw;
}

.wrapperPredictors {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: center;
	width: 100%;
	height: auto;
	top: 11.5vw;
	padding: 0 3vw;
	position: absolute;
}

.predictorsAvatars {
	display: grid;
	justify-content: space-between;
	width: 100%;
	height: 10vw;
	margin-bottom: 0.2vw;
	grid-template-rows: 100%;
	grid-template-columns: repeat(8, 10vw);
}

.predictorsNames {
	display: grid;
	justify-content: space-between;
	width: 100%;
	height: 2vw;
	margin-bottom: 1vw;
	grid-template-rows: 100%;
	grid-template-columns: repeat(8, 10vw);
}

.predictorsPickems {
	display: grid;
	justify-content: space-between;
	width: 100%;
	height: 10vw;
	margin-bottom: 1vw;
	grid-template-rows: 100%;
	grid-template-columns: repeat(8, 10vw);
}

.predictorAvatar {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 100%;
	overflow: hidden;
	border-radius: 0.8vw;
}

.predictorPhoto img {
	height: 100%;
	width: auto;
}

.predictorName {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	font-size: 1vw;
}

.pickTeam {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 100%;
	padding: 0.5vw;
	border-radius: 0.8vw;
	border: 2px solid var(--white);
}

.pickTeam img {
	height: 90%;
	width: auto;
}
