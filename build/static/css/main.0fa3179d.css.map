@font-face {
	font-family: 'DrukCyr Medium';
	src: url('../../../Fonts/DrukCyr-Medium.eot');
	src: url('../../../Fonts/DrukCyr-Medium.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/DrukCyr-Medium.woff') format('woff'), url('../../../Fonts/DrukCyr-Medium.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'Mazzard M';
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot');
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.woff') format('woff'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'DrukCyr Bold';
	src: url('../../../Fonts/DrukCyr-Bold.ttf') format('truetype');
}

@font-face {
	font-family: 'DrukTextWide';
	src: url('../../../Fonts/DRUKTEXTWIDECYR-BOLD.otf') format('truetype');
}

@font-face {
	font-family: 'Montserrat SemiBold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-SEMIBOLD.ttf') format('truetype');
}

@font-face {
	font-family: 'Montserrat Bold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-BOLD.TTF') format('truetype');
}

@font-face {
	font-family: 'Montserrat ExtraBold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-EXTRABOLD.TTF') format('truetype');
}

:local(.wrapperMatchResult) {
	/* --titleRowDark: #6c0124;
	--rowDark: #96002d;
	--rowLight: #ba013f; */

	--titleRowDark: #850533;
	--rowDark: #94103e;
	--rowLight: #b00745;

	--red: #ff181899;
	--green: #00db0099;
	--yellow: #ff961599;

	--redDark: #ff1818;
	--greenDark: #00db00;
	--yellowDark: #ff9615;

	--gold: #efc60c95;
	--white: #fff;
	--black: #000;
}

.wrapperMatchResult {
	font-family: 'DrukTextWide', sans-serif;
	display: flex;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	width: 100%;
	z-index: 20;
	position: relative;
}

.wrapperMatchResult img {
	height: auto;
	width: 100%;
}

.bgImg {
	height: auto;
	width: 100%;
}

.wrapperMenu {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	width: 100%;
	height: 160px;
	background: var(--mainLightBlack);
	margin-bottom: 10px;
	padding: 5px;
}

.wrapperLogo {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: 20%;
	height: 100%;
}

.wrapperLogo img {
	height: 70%;
	width: auto;
}

.menu {
	display: flex;
	justify-content: center;
	align-items: flex-end;
	height: 100%;
	width: 100%;
}

.wrapperListMatches {
	display: block;
	width: 100%;
	height: 100%;
	margin-right: 2%;
	margin-left: 2%;
	padding: 2px;
}

.titleBox {
	width: 100%;
	height: auto;
	padding: 1% 0;
	color: white;
}

.listMatches {
	display: block;
	overflow-y: scroll;
	border-radius: 3px;
	width: 100%;
	min-width: 150px;
	height: 120px;
	background: var(--componentBlockColor);
	color: white;
}

.match {
	background: var(--componentLightBlockColor);
	margin-bottom: 2px;
	padding: 5px;
	cursor: pointer;
	transition: all 0.5s;
}

.match:hover {
	background: var(--componentBlockColorHover);
}

.wrapperMain {
	display: flex;
	height: 100%;
	width: 100%;
	padding: 3.4%;
	position: absolute;
}

.main {
	display: block;
	height: 100%;
	width: 100%;
}

.wrapperButtons {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	width: 20%;
}

.wrapperButtons button:not(:last-child) {
	margin-bottom: 3%;
}

.btnSaveAsImage {
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 3px;
	background: var(--buttonColor);
	height: 40px;
	width: 160px;
	cursor: pointer;
	color: white;
}

.btnSaveAsImage:hover {
	background: var(--buttonColorHover);
}

.wrapperTitleBanner {
	display: flex;
	align-items: center;
	justify-content: space-between;
	position: absolute;
	top: 3vw;
	height: 5.8vw;
	padding: 0 3vw;
	font-size: 6.3vw;
	width: 100%;
}

.logoAndTitleBanner {
	display: flex;
	align-items: center;
	width: 100%;
	height: 100%;
	color: var(--white);
	font-family: 'DrukCyrMedium', sans-serif;
	font-size: 7.7vw;
}

.logoAndTitleBanner img {
	width: auto;
	height: 100%;
	margin-right: 0.8vw;
}

.titleBanner {
	margin-bottom: 0.65vw;
}

.themeBanner {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 1vw;
	width: auto;
	height: 100%;
	font-size: 2vw;
	text-wrap: nowrap;
	padding: 0 1vw;
	color: var(--black);
	background: var(--white);
}

.textTitleBanner {
	font-family: 'DrukCyrMedium', sans-serif;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	font-size: 6.9vw;
	color: white;
}

.wrapperInfoMatch {
	display: grid;
	grid-template-columns: 30% 70%;
	grid-template-rows: 100%;
	width: 100%;
	height: 9vw;
	color: var(--white);
	top: 11vw;
	padding: 0 3vw;
	text-shadow: 1px 1px 1px var(--titleRowDark);
	position: absolute;
}

.infoMatch {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	font-size: 3vw;
	padding: 0 1vw;
	border-radius: 1vw;
	overflow: hidden;
	margin-right: 2vw;
	background: var(--rowDark);
}

.wrapperTeamScore {
	display: flex;
	justify-content: center;
	align-items: center;
}

.teamLogo {
	display: flex;
	justify-content: center;
	align-items: center;
	max-width: 6vw;
	height: 100%;
	width: auto;
}

.teamLogo img {
	height: auto;
	width: 100%;
}

.teamScore {
	margin: 0 1vw;
}

.wrapperInfoTour {
	display: grid;
	grid-template-columns: 80% 20%;
	grid-template-rows: 100%;
	padding: 0 1vw 0 0;
	border-radius: 1vw;
	font-size: 1.3vw;
	background: var(--rowDark);
}

.wrapperNameAndLogoTour {
	display: grid;
	grid-template-columns: auto auto;
	grid-template-rows: 100%;
}

.tourLogo {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
}

.tourLogo img {
	height: 50%;
	width: auto;
}

.tourName {
	display: flex;
	justify-content: flex-start;
	align-items: center;
}

.tourDate {
	display: flex;
	justify-content: center;
	align-items: center;
}

.wrapperMapsMatch {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: 100%;
	height: 9vw;
	color: var(--white);
	top: 22vw;
	padding: 0 3vw;
	overflow: hidden;
	position: absolute;
	text-shadow: 1px 1px 1px var(--titleRowDark);
}

.wrapperMapsMatch .wrapperMap:not(:last-child) {
	margin-right: 1vw;
}

.wrapperMapsMatch .wrapperMapMore:not(:last-child) {
	margin-right: 1vw;
}

.wrapperMap {
	display: grid;
	grid-template-columns: minmax(22vw, 30vw) minmax(35vw, auto);
	grid-template-rows: 100%;
	grid-template-areas: 'infoMap logoMap';
	width: 100%;
	height: 100%;
	border-radius: 1vw;
	background: var(--rowDark);
	overflow: hidden;
}

.wrapperMapMore {
	display: grid;
	grid-template-columns: 100%;
	grid-template-rows: 40% 60%;
	grid-template-areas:
		'logoMap'
		'infoMap';
	width: 100%;
	height: 100%;
	border-radius: 1vw;
	background: var(--rowDark);
	overflow: hidden;
}

.logoMapGradientMore {
	position: absolute;
	z-index: 3;
	height: 1vw;
	width: 100%;
	bottom: 0;
	background: linear-gradient(to top, var(--rowDark), transparent);
}

.infoMap {
	display: grid;
	grid-template-columns: 70% 30%;
	grid-template-rows: 50% 50%;
	grid-template-areas:
		'nameMap scoreT1'
		'pickMap scoreT2';
	grid-area: infoMap;
	width: 100%;
	font-size: 0.8vw;
}

.infoMapMore {
	display: grid;
	grid-template-columns: 65% 35%;
	grid-template-rows: 50% 50%;
	grid-template-areas:
		'nameMap scoreT1'
		'pickMap scoreT2';
	grid-area: infoMap;
	padding: 0.3vw 0;
	height: 100%;
	width: 100%;
	font-size: 0.8vw;
}

.pickMapTitle {
	font-family: 'MONTSERRAT-SEMIBOLD', sans-serif;
}
.pickMapTitle {
	font-family: 'MONTSERRAT-SEMIBOLD', sans-serif;
}

.logoMap {
	display: flex;
	justify-content: center;
	align-items: center;
	grid-area: logoMap;
	height: 100%;
	width: 100%;
	overflow: hidden;
	position: relative;
}

.logoMap img {
	position: absolute;
	z-index: 2;
	height: 130%;
	width: auto;
}

.logoMap .logoMapGradient {
	position: absolute;
	z-index: 3;
	height: 100%;
	width: 5vw;
	left: 0;
	background: linear-gradient(to right, var(--rowDark) 1vw, transparent);
}

.nameMap {
	display: flex;
	justify-content: center;
	align-items: start;
	flex-direction: column;
	grid-area: nameMap;
	padding-left: 1.5vw;
}

.pickMap {
	display: flex;
	justify-content: center;
	align-items: start;
	flex-direction: column;
	overflow: hidden;
	grid-area: pickMap;
	text-wrap: nowrap;
	padding-left: 1.5vw;
}

.scoreT1 {
	display: flex;
	justify-content: flex-end;
	align-items: center;
	padding: 0 1vw;
	min-width: 2vw;
	grid-area: scoreT1;
	font-size: 1vw;
}

.scoreT2 {
	display: flex;
	justify-content: flex-end;
	align-items: center;
	padding: 0 1vw;
	min-width: 2vw;
	grid-area: scoreT2;
	font-size: 1vw;
}

.score {
	display: flex;
	justify-content: center;
	align-items: center;
	min-width: 2vw;
	width: 100%;
	height: 100%;
}

.scoreTLogo {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	margin-right: 0.5vw;
}

.scoreTLogo img {
	width: auto;
	min-width: 2vw;
	height: 100%;
	min-height: 2vw;
	max-height: 2vw;
}

.wrapperStatsT1 {
	top: 33vw;
	padding: 0 3vw;
	height: 31vw;
	width: 100%;
	position: absolute;
	text-shadow: 1px 1px 1px var(--titleRowDark);
}

.wrapperStatsT2 {
	display: flex;
	justify-content: center;
	top: 66vw;
	padding: 0 3vw;
	height: 31vw;
	width: 100%;
	position: absolute;
	text-shadow: 1px 1px 1px var(--titleRowDark);
}

.wrapperTable {
	display: grid;
	grid-template-columns: 100%;
	grid-template-rows: repeat(6, 1fr);
	width: 100%;
	height: 100%;
	row-gap: 0.5vw;
	border-radius: 1vw;
	color: var(--white);
	overflow: hidden;
	background: var(--titleRowDark);
	font-size: 1.3vw;
}

.tableRowTitle {
	display: grid;
	grid-template-columns: 28% repeat(9, 8%);
	grid-template-rows: 100%;
	height: 100%;
	font-size: 1vw;
	background: var(--rowDark);
}

.tableRowTitle .cell:not(:last-child) {
	margin-right: 0.5vw;
}

.tableRow .cell:not(:last-child) {
	margin-right: 0.5vw;
}

.tableRow {
	display: grid;
	grid-template-columns: 28% repeat(9, 8%);
	grid-template-rows: 100%;
	height: 100%;
	width: 100%;
}

.tableRow:nth-child(even) > * {
	background: var(--rowLight);
}

.cell {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	background: var(--rowDark);
}

.cellPlayer {
	display: grid;
	grid-template-columns: 10% 30% 60%;
	grid-auto-rows: 100%;
	padding-left: 2vw;
	align-items: center;
	height: 100%;
	margin-right: 0.5vw;
	overflow: hidden;
	background: var(--rowDark);
}

.dataFlagPlayer {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 70%;
}

.photoPlayer {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
	position: relative;
}

.photoPlayer img {
	top: -0.1vw;
	height: 230%;
	width: auto;
	position: absolute;
}

.nickname {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	height: 100%;
	width: 70%;
	margin-left: 1vw;
}
