@font-face {
	font-family: 'DrukCyrMedium';
	src: url('../../../Fonts/DrukCyr-Medium.eot');
	src: url('../../../Fonts/DrukCyr-Medium.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/DrukCyr-Medium.woff') format('woff'), url('../../../Fonts/DrukCyr-Medium.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'Mazzard M';
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot');
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.woff') format('woff'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'DrukCyr Bold';
	src: url('../../../Fonts/DrukCyr-Bold.ttf') format('truetype');
}

@font-face {
	font-family: 'DrukTextWide';
	src: url('../../../Fonts/DRUKTEXTWIDECYR-BOLD.otf') format('truetype');
}

@font-face {
	font-family: 'Montserrat SemiBold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-SEMIBOLD.ttf') format('truetype');
}

@font-face {
	font-family: 'Montserrat Medium';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-MEDIUM.TTF') format('truetype');
}

@font-face {
	font-family: 'Montserrat Bold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-BOLD.TTF') format('truetype');
}

:local(.wrapperTopResult) {
	--titleRowDark: #850533;
	--rowDark: #94103e;
	--rowLight: #b00745;

	--red: #ff181899;
	--green: #00db0099;
	--yellow: #ff961599;

	--redDark: #ff1818;
	--greenDark: #00db00;
	--yellowDark: #ff9615;

	--gold: #efc60c95;
	--white: #fff;
	--black: #000;
}

.bgImg {
	height: auto;
	width: 100%;
}

.wrapperMenu {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	width: 100%;
	height: 15%;
	background: var(--mainLightBlack);
	margin-bottom: 10px;
	padding: 5px;
}

.wrapperLogo {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: 10%;
	height: 100%;
}

.wrapperLogo img {
	height: auto;
	width: 100%;
}

.menu {
	display: flex;
	justify-content: center;
	align-items: flex-end;
	height: 100%;
	width: 60%;
}

.wrapperListMatches {
	display: block;
	width: 100%;
	height: 100%;
	margin-right: 2%;
	margin-left: 2%;
	padding: 2px;
}

.titleBox {
	width: 100%;
	height: auto;
	padding: 1% 0;
	color: white;
}

.listMatches {
	display: block;
	overflow-y: scroll;
	border-radius: 8px;
	width: 100%;
	min-width: 150px;
	height: 120px;
	background: var(--componentBlockColor);
	color: white;
}

.match {
	background: var(--componentLightBlockColor);
	margin-bottom: 2px;
	padding: 5px;
	cursor: pointer;
	transition: all 0.5s;
}

.match:hover {
	background: var(--componentBlockColorHover);
}

.btnSaveAsImage {
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 8px;
	padding: 1%;
	background: var(--buttonColor);
	height: 120px;
	width: 100%;
	cursor: pointer;
	color: white;
}

.btnSaveAsImage:hover {
	background: var(--buttonColorHover);
}

.wrapperTopResult {
	font-family: 'DrukCyrMedium', sans-serif;
	display: block;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	width: 100%;
	z-index: 20;
	position: relative;
}

.wrapperTopResult img {
	height: auto;
	width: 100%;
}

.wrapperTitleBanner {
	display: flex;
	align-items: center;
	justify-content: space-between;
	position: absolute;
	top: 3vw;
	height: 6vw;
	padding: 0 3vw;
	width: 100%;
}

.logoAndTitleBanner {
	display: flex;
	width: 100%;
	height: 100%;
	color: var(--white);
	font-size: 7vw;
}

.logoAndTitleBanner img {
	width: auto;
	height: 100%;
	margin-right: 0.8vw;
}

.titleBanner {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	margin-top: 0.05vw;
}

.themeBanner {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 1vw;
	width: auto;
	height: 5vw;
	font-size: 1.6vw;
	text-wrap: nowrap;
	padding: 0 1vw;
	color: var(--black);
	background: var(--white);
}

.textTitleBanner {
	font-family: 'DrukCyrMedium', sans-serif;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	color: white;
}

.wrapperBannerInfo {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	top: 1%;
	height: 12%;
	width: 100%;
	padding: 0 3vw;
	position: absolute;
}

.nameTour {
	font-family: 'Montserrat Medium', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	width: auto;
	color: #eee9ec;
	margin-top: 0.5vw;
	font-size: 1.5vw;
}

.wrapperTableSection {
	top: 12vw;
	height: 100%;
	width: 100%;
	padding: 0 3vw;
	position: absolute;
}

.wrapperTableTitle {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 2%;
	margin-bottom: 1vw;
}

.wrapperTableSection .wrapperTable:nth-child(odd) {
	background: var(--rowLight);
}

.tableTitle {
	font-family: 'DrukTextWide', sans-serif;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	height: 3vw;
	width: 100%;
	border-radius: 1vw;
	background: var(--white);
	color: var(--black);
}

.tableTitle div {
	font-size: 1.1vw;
	display: flex;
	justify-content: center;
	align-items: center;
}

.tableTitle div:not(:last-child) {
	margin-right: 0.4vw;
}

.wrapperTable {
	font-family: 'DrukTextWide', sans-serif;
	display: grid;
	grid-template-columns: 5% 26% 53% 8% 8%;
	width: 100%;
	height: 7.5vw;
	top: 12.5vw;
	border-radius: 1vw;
	overflow: hidden;
	text-shadow: 1px 1px 1px var(--titleRowDark);
	background: var(--rowDark);
	margin-bottom: 0.8vw;
	color: var(--white);
}

.wrapperTable div:not(:last-child) {
	margin-right: 0.4vw;
}

.dataNumberPlayerTitle {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
	font-size: 1.4vw;
}

.wrapperTeam {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	height: 100%;
	width: 100%;
	font-size: 1.1vw;
}

.dataRoster {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
	position: relative;
}

.dataPoints {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
	font-size: 1.5vw;
}

.dataDiffPosition {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
	font-size: 1.5vw;
}

.wrapperMetric {
	display: grid;
	grid-template-columns: 70% 30%;
	grid-template-rows: 100%;
	width: 100%;
}

.metricValue {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: 100%;
}

.metricSign {
	display: flex;
	justify-content: flex-end;
	align-items: center;
	padding-right: 0.8vw;
	height: 100%;
	width: 100%;
}

.metricSign img {
	height: auto;
	width: 40%;
}

.logoTeam {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 30%;
}

.dataNameTeam {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	height: 100%;
	width: 70%;
}

.dataFlagTeamCountry {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	margin-right: 10%;
	width: 10%;
}

.logoTeam img {
	height: 60%;
	width: auto;
}

.playerRoster {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 18%;
	background: var(--titleRowDark);
	padding-top: 8%;
	overflow: hidden;
	position: relative;
}

.nicknamePlayerRoster {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: center;
	align-items: flex-end;
	height: 20%;
	bottom: 0;
	width: 100%;
	background: var(--titleRowDark);
	font-size: 1.2vw;
	position: absolute;
}

.playerRoster img {
	height: 160%;
	width: auto;
	position: absolute;
}
