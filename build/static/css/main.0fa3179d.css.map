:local(.wrapperTopResult) {
	--titleRowDark: #850533;
	--rowDark: #94103e;
	--rowLight: #b00745;

	--red: #ff181899;
	--green: #00db0099;
	--yellow: #ff961599;

	--redDark: #ff1818;
	--greenDark: #00db00;
	--yellowDark: #ff9615;

	--gold: #efc60c95;
	--white: #fff;
	--black: #000;
}

.wrapperTopResult {
	font-family: 'DrukTextWide', sans-serif;
	display: block;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	width: 100%;
	z-index: 20;
	color: white;
	position: relative;
}

.wrapperTopResult img {
	height: auto;
	width: 100%;
}

.wrapperMatches {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: center;
	width: 100%;
	height: auto;
	top: 11.5vw;
	padding: 0 3vw;
	position: absolute;
}

.wrapperInfoMatches {
	display: grid;
	justify-content: space-between;
	align-content: center;
	width: 100%;
	height: 5.5vw;
	top: 3vw;
	padding: 0 3vw;
	grid-template-rows: 100%;
	grid-template-columns: auto auto;
	position: absolute;
}

.logoRankoff {
	display: flex;
	align-items: center;
	width: auto;
	height: 100%;
}

.logoRankoff img {
	height: 100%;
	width: auto;
}

.wrapperTitleBanner {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: flex-end;
	align-items: center;
	width: 100%;
	font-size: 2vw;
	height: 100%;
}

.titleBanner {
	display: flex;
	justify-content: center;
	align-items: center;
	width: auto;
	padding: 0 1vw;
	font-size: 2vw;
	height: 4vw;
	color: var(--black);
	border-radius: 0.8vw;
	background: var(--white);
}

.dateMatches {
	display: flex;
	justify-content: center;
	align-items: center;
	width: auto;
	height: 100%;
	margin-right: 1.5vw;
	font-size: 2vw;
}

.match {
	display: grid;
	grid-template-columns: 40% 20% 40%;
	grid-template-rows: 60% 25% 15%;
	grid-template-areas:
		'team1Players format team2Players'
		'team1Info time team2Info'
		'tourInfo tourInfo tourInfo';
	height: 15.5vw;
	width: 100%;
	border-radius: 1vw;
	margin-bottom: 1vw;
	background: var(--rowDark);
	overflow: hidden;
}

.team1Players {
	grid-area: team1Players;
	display: block;
	position: relative;
	overflow: hidden;
	background: var(--rowLight);
}

.wrapperFormat {
	grid-area: format;
	display: grid;
	grid-auto-rows: 30% 70%;
}

.format {
	display: flex;
	justify-content: center;
	align-items: flex-end;
	height: 100%;
	font-family: 'Montserrat Bold', sans-serif;
	font-size: 1.5vw;
	background: var(--rowLight);
}

.versus {
	display: flex;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	font-family: 'DrukTextWide', sans-serif;
	font-size: 5vw;
	background: var(--rowLight);
}

.team2Players {
	grid-area: team2Players;
	display: block;
	position: relative;
	overflow: hidden;
	background: var(--rowLight);
}

.team1Info {
	grid-area: team1Info;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 1.5vw;
	background: var(--titleRowDark);
}

.teamLogo {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	margin-right: 0.5vw;
}

.teamLogo img {
	width: auto;
	height: 80%;
}

.teamName {
	display: flex;
	justify-content: center;
	align-items: center;
}

.time {
	font-family: 'Montserrat Bold', sans-serif;
	grid-area: time;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 2.5vw;
	background: var(--titleRowDark);
}

.team2Info {
	grid-area: team2Info;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 1.5vw;
	background: var(--titleRowDark);
}

.tourInfo {
	grid-area: tourInfo;
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: center;
	grid-template-rows: 100%;
	height: 100%;
	font-size: 1vw;
}

.nameTourAndLogo {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 100%;
}

.nameTour {
	display: flex;
	justify-content: center;
	align-items: center;
}

.logoTour {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
}

.logoTour img {
	height: 80%;
	width: auto;
}

.backLogoTeam {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
	opacity: 0.5;
	filter: blur(0.1vw);
	position: absolute;
	z-index: 1;
}

.wrapperPlayers {
	display: flex;
	justify-content: space-around;
	align-items: flex-end;
	height: 100%;
	width: 100%;
	z-index: 2;
	position: relative;
}

.wrapperPlayers img {
	padding-top: 0.3vw;
	height: auto;
	width: 110%;
}

.player {
	display: flex;
	justify-content: center;
	align-items: flex-start;
	width: 100%;
	height: 100%;
	overflow: hidden;
}
