@font-face {
	font-family: 'DrukCyr Medium';
	src: url('../../../Fonts/DrukCyr-Medium.eot');
	src: url('../../../Fonts/DrukCyr-Medium.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/DrukCyr-Medium.woff') format('woff'), url('../../../Fonts/DrukCyr-Medium.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'Mazzard M';
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot');
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.woff') format('woff'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'DrukCyr Bold';
	src: url('../../../Fonts/DrukCyr-Bold.ttf') format('truetype');
}

@font-face {
	font-family: 'DrukTextWide';
	src: url('../../../Fonts/DRUKTEXTWIDECYR-BOLD.otf') format('truetype');
}

@font-face {
	font-family: 'Montserrat SemiBold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-SEMIBOLD.ttf') format('truetype');
}

@font-face {
	font-family: 'Montserrat Bold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-BOLD.TTF') format('truetype');
}

@font-face {
	font-family: 'Montserrat ExtraBold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-EXTRABOLD.TTF') format('truetype');
}

:local(.wrapperTopResult) {
	--titleRowDark: #850533;
	--rowDark: #94103e;
	--rowLight: #b00745;

	--red: #ff181899;
	--green: #00db0099;
	--yellow: #ff961599;

	--redDark: #ff1818;
	--greenDark: #00db00;
	--yellowDark: #ff9615;

	--gold: #efc60c95;
	--white: #fff;
	--black: #000;
}

.wrapperMenu {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	width: 100%;
	height: 150px;
	background: var(--mainLightBlack);
	margin-bottom: 10px;
	padding: 5px;
	color: white;
}

.wrapperLogo {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: auto;
	height: 100%;
}

.bgImg {
	height: auto;
	width: 100%;
}

.wrapperLogo img {
	height: 70%;
	width: auto;
}

.menu {
	display: flex;
	justify-content: center;
	align-items: flex-end;
	height: 100%;
	width: 100%;
}

.wrapperListMatches {
	display: block;
	width: 100%;
	height: 100%;
	margin-right: 2%;
	margin-left: 2%;
	padding: 2px;
}

.listMatches {
	display: block;
	overflow-y: scroll;
	border-radius: 3px;
	width: 100%;
	min-width: 150px;
	height: 120px;
	background: var(--componentBlockColor);
	color: white;
}

.match {
	background: var(--componentLightBlockColor);
	margin-bottom: 2px;
	padding: 5px;
	cursor: pointer;
	transition: all 0.5s;
}

.match:hover {
	background: var(--componentBlockColorHover);
}

.btnSaveAsImage {
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 3px;
	padding: 1%;
	background: var(--buttonColor);
	height: 120px;
	width: 100%;
	cursor: pointer;
	color: white;
}

.btnSaveAsImage:hover {
	background: var(--buttonColorHover);
}

.wrapperTopResult {
	display: block;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	width: 100%;
	z-index: 20;
	overflow: hidden;
	position: relative;
}

.wrapperTopResult img {
	height: auto;
	width: 100%;
}

.wrapperTitleSection {
	display: flex;
	justify-content: space-between;
	align-items: end;
	height: 5.5vw;
	top: 3vw;
	width: 100%;
	padding: 0 3vw;
	position: absolute;
}

.titleBanner {
	display: flex;
	align-items: center;
	width: 100%;
	height: 100%;
	color: var(--white);
	font-family: 'DrukCyrMedium', sans-serif;
	font-size: 6.3vw;
}

.titleBanner img {
	width: auto;
	height: 100%;
	margin-right: 0.8vw;
}

.nameTourWrapper {
	background: var(--rowDark);
	display: flex;
	height: 4.9vw;
	max-width: 100%;
	padding: 0 2vw 0 0;
	border-radius: 1vw;
	color: var(--white);
}

.nameTour {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	font-family: 'DRUKTEXTWIDECYR-BOLD', sans-serif;
	font-size: 1vw;
	overflow: hidden;
}

.logoTour {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
}

.logoTour img {
	height: 80%;
	width: auto;
}

.playerAndStatsSection {
	display: grid;
	grid-template-columns: 33% 65%;
	grid-template-rows: 100%;
	height: 48vw;
	width: 100%;
	bottom: 0;
	padding: 0 1vw;
	position: absolute;
}

.wrapperPlayerInfo {
	height: 100%;
	width: 100%;
	position: relative;
}

.wrapperPlayerTeam {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 100%;
	bottom: 0;
	z-index: 1;
	position: absolute;
}

.wrapperPlayerTeam img {
	height: 100%;
	opacity: 0.8;
	width: auto;
	top: -3vw;
	position: absolute;
}

.wrapperPlayerPhoto {
	width: 100%;
	height: 100%;
	bottom: 0;
	z-index: 2;
	position: absolute;
}

.playerPhoto {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
}

.playerPhoto img {
	height: 110%;
	width: auto;
}

.wrapperPlayerPersonalInfo {
	width: 30vw;
	height: 24vw;
	left: 1.4vw;
	bottom: 0;
	z-index: 5;
	padding-top: 6vw;
	color: var(--white);
	background: radial-gradient(ellipse 15vw 25vw at bottom, var(--rowDark) 5vw, transparent);
	position: absolute;
}

.logoTeam {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 4vw;
}

.logoTeam img {
	width: auto;
	height: 100%;
}

.nickname {
	font-family: 'DrukTextWide', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 2.8vw;
	width: 100%;
}

.flagAndName {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 3vw;
	font-size: 1.3vw;
}

.flag {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	margin-right: 0.5vw;
}

.flag img {
	height: 1.5vw;
	width: auto;
}

.nameSurname {
	display: flex;
	justify-content: center;
	align-items: center;
	overflow: hidden;
}

.name {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	margin-right: 0.2vw;
}

.surname {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.age {
	font-family: 'Montserrat SemiBold', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 2vw;
	font-size: 1.2vw;
}

.wrapperPlayerStatsSection {
	height: 100%;
	width: 100%;
	z-index: 3;
	padding: 2.8vw 0 2.8vw 0;
}

.wrapperTable {
	font-family: 'Montserrat ExtraBold', sans-serif;
	max-height: 43vw;
	border-radius: 1vw;
	font-size: 1.1vw;
	overflow: hidden;
}

.wrapperTable .rowTable:nth-child(even) {
	background: var(--rowLight);
}

.rowTableTitle {
	display: grid;
	grid-template-columns: 20% 20% repeat(6, 10%);
	height: 3.6vw;
	color: var(--black);
	background: var(--white);
}

.rowTableTitle div {
	display: flex;
	justify-content: center;
	align-items: center;
}

.rowTable {
	font-family: 'DrukTextWide', sans-serif;
	display: grid;
	grid-auto-rows: minmax(3vw, 3.5vw);
	grid-template-columns: 10% 10% 20% repeat(6, 10%);
	height: 100%;
	flex: 1 1 auto;
	align-items: stretch;
	color: var(--white);
	background: var(--rowDark);
}

.rowTable span {
	margin: 0 0.5vw;
}

.rowTable div {
	display: flex;
	justify-content: center;
	align-items: center;
	margin-right: 0.4vw;
}

.rowTableTotal {
	font-family: 'DrukTextWide', sans-serif;
	display: grid;
	grid-template-columns: 40% repeat(6, 10%);
	min-height: 3.6vw;
	height: 100%;
	color: var(--black);
	background: var(--white);
}

.rowTableTotal div {
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 1.1vw;
	margin-right: 0.4vw;
}

.cell {
	text-shadow: 1px 1px 1px var(--titleRowDark);
}

.cellScore {
	padding-left: 3vw;
	text-shadow: 1px 1px 1px var(--titleRowDark);
}

.opponentLogo {
	display: flex;
	justify-content: center;
	align-items: center;
	margin-left: 1vw;
	height: 100%;
	width: 100%;
	overflow: hidden;
}

.opponentLogo img {
	height: auto;
	width: 40%;
}

.gradientToTop {
	background: linear-gradient(to top, var(--rowDark) 4vw, transparent);
	width: 100%;
	height: 20vw;
	z-index: 2;
	bottom: 0;
	position: absolute;
}

.total {
	font-size: 1.3vw;
	margin: 0.5vw 0;
	color: var(--white);
	text-shadow: 1px 1px 1px var(--black);
}
