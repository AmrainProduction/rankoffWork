@font-face {
	font-family: 'DrukCyrMedium';
	src: url('../../../Fonts/DrukCyr-Medium.eot');
	src: url('../../../Fonts/DrukCyr-Medium.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/DrukCyr-Medium.woff') format('woff'), url('../../../Fonts/DrukCyr-Medium.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'Mazzard M';
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot');
	src: url('../../../Fonts/Mazzard/MazzardM-SemiBold.eot?#iefix') format('embedded-opentype'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.woff') format('woff'), url('../../../Fonts/Mazzard/MazzardM-SemiBold.ttf') format('truetype');
	font-style: normal;
	font-weight: 500;
}

@font-face {
	font-family: 'DrukCyr Bold';
	src: url('../../../Fonts/DrukCyr-Bold.ttf') format('truetype');
}

@font-face {
	font-family: 'DrukTextWide';
	src: url('../../../Fonts/DRUKTEXTWIDECYR-BOLD.otf') format('truetype');
}

@font-face {
	font-family: 'Montserrat SemiBold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-SEMIBOLD.ttf') format('truetype');
}

@font-face {
	font-family: 'Montserrat Bold';
	src: url('../../../Fonts/Montserrat/MONTSERRAT-BOLD.TTF') format('truetype');
}

:local(.wrapperTopResult) {
	--titleRowDark: #850533;
	--rowDark: #94103e;
	--rowLight: #b00745;

	--red: #ff181899;
	--green: #00db0099;
	--yellow: #ff961599;

	--redDark: #ff1818;
	--greenDark: #00db00;
	--yellowDark: #ff9615;

	--gold: #efc60c95;
	--white: #fff;
	--black: #000;
}

.bgImg {
	height: auto;
	width: 100%;
}

.wrapperMenu {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	width: 100%;
	height: auto;
	background: var(--mainLightBlack);
	margin-bottom: 10px;
	padding: 5px;
}

.wrapperLogo {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	width: 10%;
	height: 100%;
	margin-right: 5%;
}

.wrapperLogo img {
	height: 70%;
	width: auto;
}

.menu {
	display: flex;
	justify-content: center;
	align-items: flex-start;
	height: 100%;
	width: 100%;
}

.menu div {
	margin-right: 1vw;
}

.wrapperList {
	display: block;
	width: 100%;
	height: 100%;
}

.titleBox {
	width: 100%;
	height: auto;
	padding: 1% 0;
	color: var(--textColor);
}

.list {
	display: block;
	overflow-y: scroll;
	border-radius: 3px;
	width: 100%;
	min-width: 150px;
	height: 120px;
	background: var(--componentBlockColor);
	color: white;
}

.match {
	background: var(--componentLightBlockColor);
	margin-bottom: 2px;
	padding: 5px;
	cursor: pointer;
	transition: all 0.5s;
}

.match:hover {
	background: var(--componentBlockColorHover);
}

.btnSaveAsImage {
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 3px;
	padding: 1%;
	background: var(--buttonColor);
	height: 100%;
	width: 100%;
	cursor: pointer;
	color: white;
}

.btnSaveAsImage:hover {
	background: var(--buttonColorHover);
}

.wrapperTopResult {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
	z-index: 20;
	color: var(--white);
	position: relative;
}

.wrapperTopResult img {
	height: auto;
	width: 100%;
}

.logoRankoff {
	font-family: 'DrukCyrMedium', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	height: 6.1vw;
	width: 100%;
	top: 3vw;
	position: absolute;
	color: var(--white);
}

.titleBanner {
	font-size: 7vw;
	margin-left: 0.8vw;
	margin-bottom: -0.3vw;
}

.logoRankoff img {
	height: 100%;
	width: auto;
}

.leftPlayer {
	display: flex;
	align-items: flex-end;
	justify-content: center;
	height: 100%;
	z-index: 1;
	left: 0;
	text-shadow: 1px 1px 1px var(--titleRowDark);
	width: 32vw;
	position: absolute;
}

.leftPlayer img {
	z-index: 2;
	height: 100%;
	width: auto;
}

.statsSection {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	flex-direction: column;
	align-items: center;
	height: 100%;
	z-index: 10;
	width: 40vw;
	padding: 11.5vw 0 0 0;
	text-shadow: 1px 1px 1px var(--titleRowDark);
	position: absolute;
}

.rightPlayer {
	display: flex;
	align-items: flex-end;
	justify-content: center;
	height: 100%;
	z-index: 1;
	right: 0;
	width: 32vw;
	text-shadow: 1px 1px 1px var(--titleRowDark);
	position: absolute;
}

.rightPlayer img {
	z-index: 2;
	height: 100%;
	width: auto;
}

.shadowToTop2 {
	height: 40vw;
	width: 100%;
	background: linear-gradient(to top, var(--rowDark) 0.5vw, transparent);
	z-index: 3;
	bottom: 0;
	position: absolute;
}

.shadowToTop {
	height: 40vw;
	width: 68vw;
	background: linear-gradient(to top, var(--rowDark) 0.5vw, transparent);
	z-index: 3;
	bottom: 0;
	position: absolute;
}

.infoPlayer {
	display: block;
	align-items: center;
	height: 21vw;
	width: 100%;
	z-index: 50;
	position: absolute;
}

.logoTeams {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 6vw;
	width: 100%;
	margin-bottom: 2vw;
}

.logoTeams img {
	height: 100%;
	width: auto;
}

.flagAndAge {
	font-family: 'Montserrat Bold', sans-serif;
	display: flex;
	justify-content: center;
	width: 100%;
	font-size: 1.2vw;
	align-items: center;
}

.flagAndAge img {
	height: 1.2vw;
	width: auto;
	margin-right: 1vw;
}

.nickname {
	display: flex;
	justify-content: center;
	font-family: 'DrukTextWide', sans-serif;
	font-size: 3vw;
	padding: 0 1vw;
	/*text-overflow: ellipsis;*/
	/*white-space: nowrap;*/
	/*overflow: hidden;*/
	/*word-wrap: break-word;*/
}

.name {
	font-family: 'Montserrat SemiBold', sans-serif;
	display: flex;
	justify-content: center;
	font-size: 1.5vw;
	padding: 0 1vw;
	/*text-overflow: ellipsis;*/
	/*white-space: nowrap;*/
	/*overflow: hidden;*/
	/*word-wrap: break-word;*/
}

.backLogoTeam {
	height: 100%;
	z-index: 0;
	filter: blur(0.2vw);
	opacity: 0.4;
	position: absolute;
}

.rankoff {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 2.9vw;
	width: 33vw;
	border-top-left-radius: 1vw;
	border-top-right-radius: 1vw;
	font-size: 1.2vw;
	background: var(--rowDark);
}

.wrapperStats {
	display: block;
	width: 100%;
	height: 41.9vw;
	border-radius: 1vw;
	overflow: hidden;
}

.wrapperStats .metric:nth-child(odd) {
	background: var(--rowLight);
}

.metric {
	display: grid;
	height: 6vw;
	grid-template-rows: 100%;
	grid-template-columns: 30% 5% 30% 5% 30%;
	background: var(--rowDark);
}

.valuePlayer {
	font-family: 'DrukTextWide', sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	color: var(--white);
	font-size: 2vw;
}

.nameMetric {
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 2vw;
	color: var(--white);
}

.metricSign {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	width: 100%;
}

.metricSign img {
	height: auto;
	width: 100%;
}

.description {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 2.9vw;
	width: 33vw;
	font-size: 1.2vw;
	border-bottom-left-radius: 1vw;
	border-bottom-right-radius: 1vw;
	background: var(--rowDark);
}
